{
  "name": "dsh-gemini-argon",
  "version": "0.6.3",
  "description": "Gemini 4 Argon on Google Vertex AI for DeepSeek Harness: images, tool calls, thinking replay, API key or service-account auth.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vertex-ai",
    "gemini",
    "gemini-4-argon",
    "google-vertex",
    "service-account",
    "oauth2",
    "image-input",
    "vision"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "engines": {
      "dsh": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cosmokit": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "author": "maysee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zh-plus/dsh-gemini-argon.git"
  },
  "homepage": "https://github.com/zh-plus/dsh-gemini-argon#readme",
  "bugs": "https://github.com/zh-plus/dsh-gemini-argon/issues",
  "publishConfig": {
    "access": "public"
  }
}
